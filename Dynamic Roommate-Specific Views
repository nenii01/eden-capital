--- Alerts & Notifications ===

Threshold Alerts

def check_alerts(df):
    alerts = []
    avg_usage = df['kWh'].mean()
    for room, usage in df.groupby('Room')['kWh'].sum().items():
        if usage > 1.5 * avg_usage:
            alerts.append(f"High usage in {room} ({(usage/avg_usage):.0%} of average)")
    return alerts

