===Cost Allocation Logic===

Common areas split equally, rooms assigned to individuals.

def calculate_costs(df):
    common_kwh = df[df['Area_Type'] == 'Common']['kWh'].sum()
    num_roommates = df['Roommate'].nunique()
    common_cost_per_person = (common_kwh * rate) / num_roommates
    
    individual_costs = {}
    for roommate in df['Roommate'].unique():
        room_kwh = df[(df['Roommate'] == roommate) & (df['Area_Type'] == 'Room')]['kWh'].sum()
        individual_costs[roommate] = (room_kwh * rate) + common_cost_per_person
    
    return individual_costs

